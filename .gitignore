# Repo specific
*.log
OLD/
CLAUDE.md

.mops/

# LLM models
*.gguf

# Various IDEs and Editors
.vscode/
.idea/
**/*~

# Mac OSX temporary files
.DS_Store
**/.DS_Store

# dfx build output. No canister here is built with dfx any more, but dfx-era .dfx/
# directories survive in existing checkouts and must never be committed -- they contain
# built wasms. Keep this rule even though the migration is done.
.dfx/
**/.dfx/

# icp-cli state.
#
# ONLY the cache is disposable: it holds build artifacts and the ids of canisters on the
# throwaway local network. `.icp/data/mappings/<env>.ids.json` holds the MAINNET canister
# ids -- the replacement for canister_ids.json -- and MUST be committed.
#
# The `**/` prefix is required, not cosmetic: a pattern containing a slash is anchored to
# the directory of this .gitignore, so a bare `.icp/cache/` would silently miss every
# nested project (src/*/, llms/*/).
**/.icp/cache/

# mops build output (the @dfinity/motoko recipe writes here before icp-cli shrinks it)
**/.mops/.build/

# generated files
**/declarations/

# rust
target/

# frontend code
node_modules/
dist/
.svelte-kit/

# environment variables
.env
**/.env

src/mAInerCreator/files/qwen2.5-0.5b-instruct-q8_0.gguf

*.pyc
__pycache__/
