# Reproducible build base image.
# Pin to a specific digest so the image itself cannot drift.
ARG PLATFORM=linux/amd64
FROM --platform=${PLATFORM} ubuntu:22.04@sha256:c7eb020043d8fc2ae0793fb35a37bff1cf33f156d4d4b12ccc7f3ef8706c38b1

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=7.81.0-1ubuntu1.24 \
    ca-certificates=20260601~22.04.1 \
    git=1:2.34.1-1ubuntu1.17 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js from NodeSource (pin major version).
# icp-cli and the official recipes need Node >= 22 (dfx only needed 20).
ARG NODE_MAJOR=22
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install icp-cli (successor to the deprecated dfx) and mops.
#
# @icp-sdk/ic-wasm is NOT optional: the @dfinity/motoko recipe shells out to `ic-wasm`
# to stamp the moc:version / template:type metadata and to shrink the module. Without
# it the build fails with "ic-wasm not found".
ARG ICP_VERSION
ARG MOPS_VERSION
RUN npm install -g \
    @icp-sdk/icp-cli@${ICP_VERSION} \
    @icp-sdk/ic-wasm \
    ic-mops@${MOPS_VERSION}

# Pre-populate the moc toolchain so the build itself does no network I/O.
# This MUST match the `[toolchain] moc` pin in each canister's mops.toml -- that pin is
# what actually selects the compiler, and therefore the wasm hash.
ARG MOC_VERSION
RUN mops toolchain use moc ${MOC_VERSION}

# No identity is created: building a wasm needs no identity under icp-cli.

# Print versions for verification
RUN echo "icp version:  $(icp --version)" \
    && echo "node version: $(node --version)" \
    && echo "mops version: $(mops --version)" \
    && echo "moc version:  $($(mops toolchain bin moc) --version)"
